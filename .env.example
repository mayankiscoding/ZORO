# ZORO environment. Copy to .env (scripts/install.sh does this and fills the generated keys). Never commit .env.
# Runtime environment: development | production.
ZORO_ENV=development
# Database URL; empty = SQLite at ./.local/zoro.db. Local Postgres: scripts/dev_db.sh url. Compose overrides this for the backend.
ZORO_DATABASE_URL=
# Secret for signing access tokens (generated by scripts/install.sh; 64 hex chars).
ZORO_SECRET_KEY=
# Data-at-rest key, base64 of 32 random bytes (generated by scripts/install.sh).
ZORO_DATA_KEY=
# Directory holding the runtime config YAML files; empty = the repo's config/ directory.
ZORO_CONFIG_DIR=
# Optional Redis URL; empty disables Redis-backed features.
ZORO_REDIS_URL=
# Object store backend: fs | minio.
ZORO_OBJECT_STORE=fs
# Directory for the fs object store.
ZORO_OBJECT_DIR=./.local/objects
# MinIO endpoint host:port (only when ZORO_OBJECT_STORE=minio).
ZORO_MINIO_ENDPOINT=127.0.0.1:9000
# MinIO access key (also the MinIO root user in docker-compose.yml).
ZORO_MINIO_ACCESS_KEY=
# MinIO secret key (also the MinIO root password in docker-compose.yml; 8+ characters).
ZORO_MINIO_SECRET_KEY=
# MinIO bucket name.
ZORO_MINIO_BUCKET=zoro
# Set to true when the MinIO endpoint uses TLS.
ZORO_MINIO_SECURE=false
# Public base URL the apps use to reach this server (pairing and OAuth callbacks: register
# <this>/v1/music/callback with Spotify and <this>/v1/communications/gmail/callback with Google).
ZORO_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Server privacy mode until the owner changes it with a signed proof: strict_private | cloud_intelligence.
ZORO_DEFAULT_PRIVACY_MODE=strict_private
# Days to keep conversation transcripts.
ZORO_CONVERSATION_RETENTION_DAYS=30
# Lifetime of access tokens in seconds.
ZORO_ACCESS_TOKEN_TTL_SECONDS=900
# Name shown to the apps during pairing.
ZORO_SERVER_NAME=ZORO
# Log level: DEBUG | INFO | WARNING | ERROR (logs are JSON and redacted).
ZORO_LOG_LEVEL=INFO
# Directory for local state (development keys, SQLite checkpoints); relative to backend/.
ZORO_LOCAL_DIR=./.local
# Create missing tables at startup; empty = true outside production. Production: python -m app.cli migrate.
ZORO_AUTO_CREATE_SCHEMA=
# Routine scheduler for automations: on | off.
ZORO_AUTOMATION_SCHEDULER=on
# Tests only: PostgreSQL + pgvector URL for `pytest -m postgres` (scripts/dev_db.sh url).
ZORO_TEST_DATABASE_URL=
# Docker Compose only: password for the postgres container (also used in the backend database URL).
ZORO_POSTGRES_PASSWORD=
# Model provider key: Google Gemini.
GEMINI_API_KEY=
# Model provider key: OpenAI.
OPENAI_API_KEY=
# Model provider key: xAI.
XAI_API_KEY=
# Model provider key: DeepSeek.
DEEPSEEK_API_KEY=
# Model provider key: Alibaba DashScope (Qwen).
DASHSCOPE_API_KEY=
# Base URL for the Qwen / DashScope endpoint; see docs/research for the region-specific value.
QWEN_BASE_URL=
# Model provider key: Moonshot.
MOONSHOT_API_KEY=
# Model provider key: Groq.
GROQ_API_KEY=
# Model provider key: Together.
TOGETHER_API_KEY=
# Base URL of a local Ollama server (for example http://127.0.0.1:11434); empty disables it.
OLLAMA_BASE_URL=
# Voice: ElevenLabs API key.
ELEVENLABS_API_KEY=
# Voice: Google Text-to-Speech API key.
GOOGLE_TTS_API_KEY=
# Spotify OAuth client id (PKCE; no secret needed).
SPOTIFY_CLIENT_ID=
# Google OAuth client id (Calendar, Gmail, Drive).
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_OAUTH_CLIENT_SECRET=
# Strava OAuth client id.
STRAVA_CLIENT_ID=
# Strava OAuth client secret.
STRAVA_CLIENT_SECRET=
# Zerodha Kite Connect API key (read-only use).
KITE_API_KEY=
# Zerodha Kite Connect API secret.
KITE_API_SECRET=
# Dhan client id (read-only use).
DHAN_CLIENT_ID=
# Dhan access token (read-only use).
DHAN_ACCESS_TOKEN=
# Flipkart affiliate id.
FLIPKART_AFFILIATE_ID=
# Flipkart affiliate token.
FLIPKART_AFFILIATE_TOKEN=
# Home Assistant base URL, for example http://homeassistant.local:8123.
HOME_ASSISTANT_URL=
# Home Assistant long-lived access token.
HOME_ASSISTANT_TOKEN=
# Home Assistant entities ZORO may control: "light.living_room=Living room|baithak, switch.fan" (or config/home_assistant.yaml).
HOME_ASSISTANT_ENTITIES=
