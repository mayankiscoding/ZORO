{
  "sourceLanguage": "en",
  "strings": {
    "${applicationName} basket compare karo": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} बास्केट की तुलना करो"
          }
        }
      }
    },
    "${applicationName} gaana chalao": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} गाना चलाओ"
          }
        }
      }
    },
    "${applicationName} mein ${section} kholo": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} में ${section} खोलो"
          }
        }
      }
    },
    "${applicationName} photo dhoondo": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName} फ़ोटो ढूँढो"
          }
        }
      }
