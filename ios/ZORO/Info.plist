<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.zoro.photo-index</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ZORO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hi</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.zoro.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zoro</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>whatsapp</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>ZORO sets the alarms and timers you ask for.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>ZORO plays, pauses and finds songs in Apple Music when you ask.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>ZORO adds and reads events when you ask.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>ZORO adds events to your calendar when you ask.</string>
	<key>NSCameraUsageDescription</key>
	<string>ZORO uses the camera only to scan the pairing code from your ZORO server.</string>
	<key>NSContactsUsageDescription</key>
	<string>ZORO finds and saves contacts when you ask, for example to send a message.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>ZORO asks for Face ID before it does something important you approved.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>ZORO reads activity and workouts to answer your fitness questions.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>ZORO runs your Home scenes when you ask.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ZORO connects to the ZORO server you run at home.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ZORO uses your location only when you ask something that needs it, like nearby stores.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ZORO listens only while the orb is listening, after you press or tap.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ZORO searches your photos on this iPhone; they don't leave it.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>ZORO adds and reads reminders when you ask.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your words are turned into text on this iPhone.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>app.zoro.conversation</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>ZOROHomeKitEntitled</key>
	<string>$(ZORO_HOMEKIT_ENTITLED)</string>
</dict>
</plist>
